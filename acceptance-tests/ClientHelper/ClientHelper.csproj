<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The pack's client helper: the run inputs, the client every test calls the app with, the record
	  of every request and response a test makes, and the one place secrets are taken out of that
	  record. Plain code with no package and no Pellerex library, and no reference to the app: the
	  tests know the app only by its address, as any client does.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>AcceptanceTests.ClientHelper</AssemblyName>
		<RootNamespace>AcceptanceTests.ClientHelper</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

</Project>
