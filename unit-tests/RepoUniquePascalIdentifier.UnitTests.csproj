<Project Sdk="Microsoft.NET.Sdk.Web">

	<!--
	  The app's unit tests. They start the app in memory from its own Program and Startup, with no
	  database, network or container, and the Dockerfile's unit-tests stage runs them on every build.
	  They are TUnit tests at the version the acceptance pack in acceptance-tests/ uses, so the app's
	  tests are written one way.

	  TUnit.Engine and TUnit.Assertions are taken instead of the TUnit package, which also brings
	  Microsoft's code coverage extension, whose licence is Microsoft's own rather than an open-source
	  one. Coverlet's extension for the testing platform (MIT) measures the coverage instead, and
	  TUnit's own JUnit reporter writes the results.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.MTP" Version="10.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
		<PackageReference Include="TUnit.Assertions" Version="1.75.0" />
		<PackageReference Include="TUnit.Engine" Version="1.75.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\api\RepoUniquePascalIdentifier.csproj" />
	</ItemGroup>

</Project>
